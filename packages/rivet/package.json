{
  "name": "@coryparry/rivet",
  "version": "0.1.14",
  "description": "Rivet repository maintenance workflows",
  "keywords": [
    "ai-agent",
    "cli",
    "github",
    "github-actions",
    "github-app",
    "issue-triage",
    "pull-request-review",
    "repository-automation",
    "rivet"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coryparrry/Rivet.git"
  },
  "bugs": {
    "url": "https://github.com/coryparrry/Rivet/issues"
  },
  "homepage": "https://github.com/coryparrry/Rivet#readme",
  "type": "module",
  "bin": {
    "rivet": "bin/rivet.mjs",
    "rivet-review-eval": "evals/review-safe-outputs.mjs",
    "rivet-audit-eval": "evals/audit-safe-outputs.mjs"
  },
  "files": [
    "assets",
    "bin",
    "evals",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run syntax && npm test",
    "eval:live-review": "node evals/review-safe-outputs.mjs",
    "eval:live-audit": "node evals/audit-safe-outputs.mjs",
    "review-lock:check": "node scripts/check-review-lock.mjs && node scripts/check-custom-endpoint-lock.mjs",
    "release:check": "npm run review-lock:check && node scripts/refresh-review-authority.mjs && node scripts/release-check.mjs",
    "pack:check": "npm pack --dry-run --json --ignore-scripts",
    "syntax": "node scripts/syntax-inventory.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "yaml": "2.9.0"
  }
}
